# Вход в iLO 3 сервера devlab (dl580, 195.19.43.29) через dgx2fpga.
# Файл читает только старый клиент OpenSSH 9.9 с DSA: ~/.local/bin/ilo (ssh ilo).
# Системный ssh 10.x не умеет ключ хоста ssh-dss, который отдаёт iLO 3.

Host bmstu-oleg
  HostName 195.19.43.14
  Port 2622
  User oleg_andrey
  IdentityFile ~/.ssh/id_ed25519_bmstu
  IdentitiesOnly yes
  ProxyCommand nc -X 5 -x 127.0.0.1:11080 %h %p
  ServerAliveInterval 15

# dgx2fpga только пересылает поток: ключ iLO остаётся на маке.
Host ilo
  HostName 195.19.43.29
  User Administrator
  ProxyJump bmstu-oleg
  IdentityFile ~/.ssh/id_ilo_devlab_dsa
  IdentitiesOnly yes
  HostKeyAlgorithms +ssh-dss
  PubkeyAcceptedAlgorithms +ssh-rsa,ssh-dss
  KexAlgorithms +diffie-hellman-group14-sha1,diffie-hellman-group1-sha1
  Ciphers +aes128-cbc,aes256-cbc,3des-cbc
  UserKnownHostsFile ~/.ssh/known_hosts_ilo
  StrictHostKeyChecking accept-new
  ServerAliveInterval 15
