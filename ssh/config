# <<< pcomp <<<

# pcomp в дороге: LAN 192.168.1.254:6000 недоступен -> через публичный fvds-форвард
# (157.22.189.111:2228 -> sshd pcomp:6000). Авторизация мак<->pcomp тем же ключом, fvds лишь TCP.
Match host pcomp exec "! /usr/bin/nc -G 1 -w 2 192.168.1.254 6000 </dev/null | head -c 64 | grep -q ^SSH-"
    HostName 157.22.189.111
    Port 2228
    StrictHostKeyChecking accept-new
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h-%p
    ControlPersist 2m

Host pcomp
    HostName 192.168.1.254
    Port 6000
    User pluttan
    IdentityFile /Users/pluttan/.ssh/id_pcomp
    ConnectTimeout 8
    ServerAliveInterval 15
    ServerAliveCountMax 4

# vpnvm по host-only линку pcomp<->vpnvm, мимо шлюза vpngw
Host vpnvm
    HostName 10.101.0.2
    HostKeyAlias vpnvm
    StrictHostKeyChecking accept-new
    User pluttan
    ProxyJump pcomp
    ServerAliveInterval 15
    ServerAliveCountMax 4

